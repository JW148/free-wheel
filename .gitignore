# Linked upstream BRouter checkout — a symlink to a separate repository.
# Never tracked here, and never modified. See CLAUDE.md.
/brouter-link

# Gradle / Java
.gradle/
build/
!buildSrc/build.gradle
*.class
local.properties

# Engine artifacts are generated by `engine/gradlew buildWasmGC generateJavaScript`, but
# they ARE committed — deliberately. Building them needs JDK 21, Gradle, and the
# `brouter-link` symlink to a separate local BRouter checkout, none of which exist on a
# static host's build machine. So the deploy has to carry them.
#
# Regenerate them with Gradle rather than editing them; the debug sidecars below are
# dev-only (`-PwasmDebug`) and stay out of the repo.
/web/public/engine/**/*.wasm.map
/web/public/engine/**/*.teadbg
/web/public/engine/**/*-deobfuscator.wasm
/web/public/engine/wasm-gc/src/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Editors / OS
.DS_Store
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Large offline datasets — never commit these
*.rd5
*.pmtiles

# On-device spike runs are captured artefacts, not source. Keep the ones that
# matter by copying them into docs/spike-*-results.md.
/docs/spike-runs/

# Copied from brouter-link/misc/profiles2 by `engine/gradlew syncProfiles`. Committed for
# the same reason as the engine above: the source of these files is a local checkout that a
# build host does not have.

# Downloaded routing data (see README)
/data/

# Local dev TLS material — the CA private key must never be committed
/web/certs/
