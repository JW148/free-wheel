# Linked upstream BRouter checkout — a symlink to a separate repository.
# Never tracked here, and never modified. See CLAUDE.md.
/brouter-link

# Gradle / Java
.gradle/
build/
!buildSrc/build.gradle
*.class
local.properties

# Generated by `engine/gradlew buildWasmGC generateJavaScript jvmParity`
/web/public/engine/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Editors / OS
.DS_Store
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Large offline datasets — never commit these
*.rd5
*.pmtiles

# On-device spike runs are captured artefacts, not source. Keep the ones that
# matter by copying them into docs/spike-*-results.md.
/docs/spike-runs/

# Generated by `engine/gradlew syncProfiles` from brouter-link/misc/profiles2
/web/public/profiles2/

# Downloaded routing data (see README)
/data/

# Local dev TLS material — the CA private key must never be committed
/web/certs/
